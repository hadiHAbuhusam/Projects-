<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Minna IT Services </title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <style>
        body { margin: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #050505; color: white; overflow: hidden; }
        
        /* UI Overlay */
        .interface {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            pointer-events: none; /* Allows clicking "through" to the 3D scene */
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 40px;
            box-sizing: border-box;
            z-index: 10;
        }

        nav { display: flex; justify-content: space-between; pointer-events: auto; }
        .logo { font-size: 1.5rem; font-weight: bold; letter-spacing: 2px; color: #00ff88; }

        .product-info { pointer-events: auto; max-width: 400px; }
        .product-info h1 { font-size: 3.5rem; margin: 0; text-transform: uppercase; }
        .product-info p { color: #888; line-height: 1.6; }
        
        .price-tag { font-size: 2rem; color: #00ff88; margin: 20px 0; display: block; }

        .buy-btn {
            background: #00ff88; border: none; padding: 15px 40px;
            font-weight: bold; cursor: pointer; border-radius: 5px;
            transition: 0.3s; pointer-events: auto;
        }
        .buy-btn:hover { background: #fff; transform: scale(1.05); }

        canvas { display: block; }
    </style>
</head>
<body>

    <div class="interface">
        <nav>
            <div class="logo">Minna Service Sudan</div>
            <div>CART (0)</div>
        </nav>

        <div class="product-info">
            
<h1>Minna Sudan ©   </h1>
            <p>Experience the future of digital transformation and provide information Technology .</p>
            <span class="price-tag">Minna </span>
          
        </div>

        <footer>© 2026 Created by Minna Service Email Customer service haditawer@gmail.com mobile+Watsup: +249111353523 </footer>
    </div>

    <div id="canvas-container"></div>

    <script>
        // --- THREE.JS SETUP ---
        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
        const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
        
        renderer.setSize(window.innerWidth, window.innerHeight);
        document.body.appendChild(renderer.domElement);

        // --- ADD LIGHTING ---
        const ambientLight = new THREE.AmbientLight(0xffffff, 0.5);
        scene.add(ambientLight);

        const pointLight = new THREE.PointLight(0x00ff88, 2);
        pointLight.position.set(5, 5, 5);
        scene.add(pointLight);

        // --- CREATE 3D OBJECT (The Product) ---
        const geometry = new THREE.OctahedronGeometry(2, 0);
        const material = new THREE.MeshPhongMaterial({ 
            color: 0x00ff88, 
            wireframe: true,
            emissive: 0x003311
        });
        const product = new THREE.Mesh(geometry, material);
        scene.add(product);

        camera.position.z = 5;

        // --- ANIMATION LOOP ---
        function animate() {
            requestAnimationFrame(animate);
            
            // Subtle rotation
            product.rotation.y += 0.01;
            product.rotation.x += 0.005;

            // Hover effect
            product.position.y = Math.sin(Date.now() * 0.002) * 0.2;

            renderer.render(scene, camera);
        }

        // --- RESPONSIVE RESIZE ---
        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });

        animate();
    </script>
</body>
</html>
